<view class="page">
  <view class="tip">最近 20 条平均记录 · 每分钟 1 条 · 下拉可刷新</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无记录，等待 1 分钟生成</view>

  <view wx:for="{{list}}" wx:key="time" class="card">
    <view class="card-time">{{item.timeStr}}</view>
    <view class="row"><text class="row-label">温度</text><text class="row-val">{{item.temp}}°C</text></view>
    <view class="row"><text class="row-label">湿度</text><text class="row-val">{{item.hum}}%</text></view>
    <view class="row"><text class="row-label">重量</text><text class="row-val">{{item.weight}}g</text></view>
    <view class="row"><text class="row-label">水流</text><text class="row-val">{{item.flow}}L/min</text></view>
    <view class="row"><text class="row-label">红外</text><text class="row-val">{{item.irtemp}}°C</text></view>
    <view class="row"><text class="row-label">烟雾</text><text class="row-val">{{item.gas}}</text></view>
    <view class="row"><text class="row-label">光照</text><text class="row-val">{{item.lux}}</text></view>
  </view>
</view>
